# besthomas.com — Next.js app run by systemd (besthomas.service) on 127.0.0.1:3100.
# Installed to /etc/frankenphp/sites/ by deploy/setup-server.sh.
#
# The domain is proxied by Cloudflare (SSL mode Full). Cloudflare forwards plain-HTTP requests to this
# server, so Let's Encrypt's HTTP-01 challenge works and Caddy can issue the origin certificate itself.

(besthomas_app) {
	encode zstd gzip

	# Behind Cloudflare the visitor's IP is in CF-Connecting-IP. Only trust that header when the request
	# really comes from Cloudflare, so nobody can fake it by talking to this server directly.
	# Ranges from https://www.cloudflare.com/ips/
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy 127.0.0.1:3100 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}

	log {
		output file /var/log/frankenphp/besthomas.com.access.log
	}
}

besthomas.com {
	tls hello@besthomas.com
	import besthomas_app
}

www.besthomas.com {
	tls hello@besthomas.com
	redir https://besthomas.com{uri} permanent
}
