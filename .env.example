# Password for /admin. Required — the admin panel stays locked without it.
ADMIN_PASSWORD=change-me

# Optional: secret used to sign the login cookie. Defaults to a value derived from ADMIN_PASSWORD,
# so changing the password also logs out every session.
# SESSION_SECRET=

# Public URL of the site, used for sitemap, RSS and social previews.
SITE_URL=https://besthomas.com

# Where posts, uploads and site settings are stored. Defaults to ./data
# CONTENT_DIR=/app/data

# Timezone used for "today" when a Markdown file has no date. Defaults to Asia/Shanghai
# SITE_TIMEZONE=Asia/Shanghai
